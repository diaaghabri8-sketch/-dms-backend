# Connexion base de données — optionnelle en développement local (défaut : SQLite dans
# dev_demo.db, aucune variable nécessaire). En production (Render), DATABASE_URL est définie
# dans l'environnement et pointe vers Postgres/Supabase : récupérer l'URI "Connection string"
# (mode "Session pooler" ou direct selon le cas) depuis Project Settings > Database sur
# supabase.com. Voir SUIVI_PROJET.md.
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres

# Auth JWT
SECRET_KEY=change_me_to_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Domaine des emails générés automatiquement à la création d'un compte (prenom.nom@domaine)
ACCOUNT_EMAIL_DOMAIN=dms.tn

# CORS — origines autorisées, séparées par des virgules (jamais en dur dans le code : en
# production, pointe vers l'URL Vercel du frontend). Défaut : http://localhost:5173 (dev local).
# CORS_ORIGINS=http://localhost:5173,https://mon-app.vercel.app

# Veille marchés publics (voir services/marches_publics.py) — mots-clés séparés par des
# virgules, extensible sans toucher au code.
APPELS_OFFRES_MOTS_CLES=respirateur,pousse-seringue,échographe,défibrillateur,moniteur,oxygénothérapie
APPELS_OFFRES_DELAI_SECONDES=2.0
APPELS_OFFRES_SCAN_HEURE=6
